{
	"name": "khu-phaen",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Repository tooling for backend-worker and its scripts. The frontend lives in web/ and has its own package.json.",
	"scripts": {
		"test": "vitest run",
		"lint:design": "npx @google/design.md lint DESIGN.md",
		"worker:dev": "cd backend-worker && wrangler dev",
		"worker:migrate:local": "wrangler d1 migrations apply khun-phaen --local --config backend-worker/wrangler.jsonc",
		"worker:check": "cargo check --manifest-path backend-worker/Cargo.toml --target wasm32-unknown-unknown",
		"worker:test": "cargo test --manifest-path backend-worker/Cargo.toml",
		"worker:build": "cd backend-worker && worker-build --release",
		"worker:setup": "node scripts/prepare-worker.mjs",
		"worker:smoke": "node scripts/test-worker.mjs",
		"worker:import-mongo": "node scripts/mongo-to-d1.mjs"
	},
	"devDependencies": {
		"vitest": "^4.0.18",
		"wrangler": "4.158.0"
	}
}
